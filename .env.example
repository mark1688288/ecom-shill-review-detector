# SPDX-License-Identifier: GPL-3.0-only
# Copy to .env (gitignored). Never commit secrets.

APP_ENV=dev

# Required for any command that HMAC-hashes reviewer ids. CI injects a >=16 char test value.
# Must not be empty. Generate your own; do not reuse the CI dummy salt in real runs.
REVIEWER_ID_SALT=

# Required only for load / layer1 / layer2 / audit / analyze / report (lazy; crawl --dry-run does not read these).
GCP_PROJECT=
GCP_LOCATION=asia-east1
BQ_DATASET=ecom_shill
GCS_STAGING_BUCKET=
BQ_CONNECTION_ID=ecom_shill_vertex
# Gemini Flash is not served in asia-east1. BQ + embedding stay GCP_LOCATION.
# GEMINI_LOCATION=global

# Model ids live in env/config only — do not pin retired ids as TypeScript constants.
# Check current Vertex GA Flash at implementation time.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_BUDGET=0
GEMINI_THINKING_LEVEL=MINIMAL
GEMINI_TEMPERATURE=0
GEMINI_MAX_OUTPUT_TOKENS=1024

EMBEDDING_MODEL=text-multilingual-embedding-002
COSINE_DISTANCE_THRESHOLD=0.28
CROSS_STORE_COSINE_DISTANCE_THRESHOLD=0.20

AUDIT_CONCURRENCY=8
MAX_GEMINI_REVIEWS_PER_RUN=5000
PROMPT_VERSION=v1
LOG_LEVEL=info

# Optional local fallback (not the v1 default; Vertex ADC is).
# GEMINI_API_KEY=
